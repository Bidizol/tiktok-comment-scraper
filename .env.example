# Copy to .env and set values appropriate for the host.
# Never commit real credentials.

DATA_DIR=data
LOG_DIR=data/logs
REPORT_DIR=data/reports
DATABASE_PATH=data/scraper.sqlite3

HTTP_BACKEND=urllib
PROXY_MODE=disabled
# PROXY_URL=http://username:password@proxy.example:8080

MAX_WORKERS=3
COMMENTS_PER_PAGE=50
MAX_COMMENTS_PER_VIDEO=10000
MAX_PAGES_PER_VIDEO=250
REQUEST_TIMEOUT_SECONDS=30
MINIMUM_FREE_BYTES=104857600
LOG_LEVEL=INFO
