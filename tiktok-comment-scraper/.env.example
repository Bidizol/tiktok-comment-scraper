# Copy to .env and set values appropriate for the host.
# Never commit real credentials.

DATA_DIR=data
LOG_DIR=data/logs
REPORT_DIR=data/reports
DATABASE_PATH=data/scraper.sqlite3

HTTP_BACKEND=urllib
PROXY_MODE=disabled
PROXY_REQUIRED=0
# Change PROXY_MODE to optional or required when configuring a proxy.
# Legacy command-line proxy fields (alternative to PROXY_URL):
# PROXY_HOST=proxy.example
# PROXY_PORT=8080
# PROXY_USER=username
# PROXY_PASS=password
# PROXY_URL=http://username:password@proxy.example:8080

MAX_WORKERS=3
COMMENTS_PER_PAGE=50
MAX_COMMENTS_PER_VIDEO=10000
MAX_PAGES_PER_VIDEO=250
REQUEST_TIMEOUT_SECONDS=30
HTTP_CONNECT_TIMEOUT_SECONDS=15
HTTP_READ_TIMEOUT_SECONDS=20
HTTP_TOTAL_TIMEOUT_SECONDS=30
HTTP_MAX_RESPONSE_BYTES=5242880
HTTP_MAX_RETRIES=3
MINIMUM_FREE_BYTES=104857600
LOG_LEVEL=INFO

DIAGNOSTICS_MAX_BYTES=10485760
DIAGNOSTICS_BACKUP_COUNT=5
